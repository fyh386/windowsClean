#include "resource.h"

IDI_APP               ICON    "..\\assets\\app.ico"
IDR_EVERYTHING_EXE    RCDATA  "..\\third_party\\Everything-portable\\Everything.exe"
IDR_EVERYTHING_DLL    RCDATA  "..\\third_party\\Everything-SDK\\dll\\Everything64.dll"

IDR_VERSIONINFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x00040004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WindowsClean"
            VALUE "FileDescription",  "WindowsClean - lightweight cleanup utility"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "WindowsClean"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "WindowsClean.exe"
            VALUE "ProductName",      "WindowsClean"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
